# HealthLens Environment Variables for Vercel Deployment

# JWT Secret Key
SECRET_KEY=healthlens-production-secret-key-change-this

# NVIDIA NIM AI Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Optional: External Persistent Database URL (e.g. Neon Postgres / Supabase)
# If left unset, HealthLens uses SQLite at /tmp/healthlens.db
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
